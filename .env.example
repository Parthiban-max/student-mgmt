DJANGO_SECRET_KEY=replace-this-with-a-private-unique-random-secret-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set DJANGO_DB_ENGINE=postgresql and configure POSTGRES_* to use PostgreSQL.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=student_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Set only when HTTPS is enforced throughout the domain.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
